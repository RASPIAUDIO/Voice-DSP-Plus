foreach(_v2_setting IN LISTS _v2_settings)
    string(REGEX REPLACE "=.*" "" _v2_key "${_v2_setting}")
    list(FILTER APP_COMPILE_DEFINITIONS EXCLUDE REGEX "^${_v2_key}(=|$)")
    list(APPEND APP_COMPILE_DEFINITIONS "${_v2_setting}")
endforeach()
set(TARGET_SUFFIX "v2-i2s-ui-${BUILD_PROFILE}")
